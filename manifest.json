{
  "manifest_version": 3,
  "name": "BrightView",
  "version": "2.0.1",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*/d2l/*"],
  "description": "A Brightspace/D2L grade viewing and analysis tool.",
  "content_scripts": [ 
    {
    "matches": ["https://*/d2l/lms/grades/my_grades/*"],
    "js": ["Analysis.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "B(16x).png"  , 
    "48":  "B(48x).png" ,
    "128": "B(128x).png"  
  }
}
